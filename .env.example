# Copy this file to .env and fill in the values before starting the container.
# Never commit .env to the repository.

# ── LLM ────────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
REASONING_MODEL=claude-sonnet-4-6
FAST_MODEL=claude-haiku-4-5-20251001
MAX_TOKENS=4096
CACHE_SYSTEM_PROMPT=true
MAX_BUDGET_USD=10.00
BUDGET_DURATION=1d
LOG_LLM_PROMPTS=true
LOG_LLM_RESPONSES=true
LOG_MESSAGE_MAX_CHARS=
LOG_RESPONSE_MAX_CHARS=

# ── App / Browser ──────────────────────────────────────────────────────────────
BASE_URL=
LOGIN_URL=
PLATFORM=ivalua
FLOWPROBE_HEADLESS=false
SLOW_MO_MS=0
AUTH_USERNAME_FIELD=Email Address
AUTH_PASSWORD_FIELD=Password

# ── Agent ──────────────────────────────────────────────────────────────────────
MAX_ACTIONS_PER_CLAIM=
MAX_RETRIES_PER_CLAIM=

# ── Evidence / Fingerprints ────────────────────────────────────────────────────
EVIDENCE_OUTPUT_DIR=evidence
FINGERPRINTS_DIR=flows
SCREENSHOT_ON_EVERY_ACTION=false
SCREENSHOT_ON_VERDICT=true

# ── Logging ────────────────────────────────────────────────────────────────────
# Leave SEQ_URL blank to disable Seq structured logging
SEQ_URL=
LOG_FILE=flowprobe.log

# ── Object storage ─────────────────────────────────────────────────────────────
# Leave STORAGE_BUCKET blank to disable uploads entirely.
# Set STORAGE_ENDPOINT_URL for local S3-compatible servers; leave blank for real AWS S3.
STORAGE_BUCKET=
STORAGE_ENDPOINT_URL=
STORAGE_PRESIGN_EXPIRY_SECONDS=604800
# Leave blank to use EC2 IAM role
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
