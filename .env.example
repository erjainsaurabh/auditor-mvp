# Copy this file to .env and fill in the values before starting the container.
# Never commit .env to the repository.

# Anthropic API key for LLM calls
ANTHROPIC_API_KEY=sk-ant-api03-...

# Application credentials (injected into test flows at runtime)
APP_USERNAME=your-app-username
APP_PASSWORD=your-app-password

# Object storage — set backend: s3 or minio in config.yaml to activate
# For AWS S3: use AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY instead
MINIO_ACCESS_KEY=your-minio-access-key
MINIO_SECRET_KEY=your-minio-secret-key
